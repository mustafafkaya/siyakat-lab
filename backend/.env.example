# Veritabanı
DATABASE_URL=postgresql://siyakat:siyakat@db:5432/siyakat_lab

# Güvenlik
SECRET_KEY=degistir-bu-cok-gizli-bir-anahtar-olmali
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dosya depolama (V1: local, ileride "s3" gibi başka backend eklenebilir)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# AI servis (V2'de gerçek modelle değişecek, şimdilik dummy)
AI_SERVICE_MODE=dummy

# İlk yönetici (bootstrap): `python -m app.seed` bu bilgilerle admin oluşturur
# Not: .local / .test gibi rezerve uzantılar geçersizdir — gerçek bir alan adı kullanın
FIRST_SUPERUSER_EMAIL=admin@siyakat-lab.com
FIRST_SUPERUSER_PASSWORD=changeme
FIRST_SUPERUSER_NAME=Sistem Yöneticisi

# Loglama seviyesi (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
